rules_version = '2';

// Collections :
//   admins/{uid}        compte admin (créé à la main dans la console Firebase)
//   private/access      { key } clé secrète contenue dans le QR code bénévoles
//   devices/{uid}       téléphone bénévole du jour { key, firstName, lastName, day, createdAt, expiresAt, leftAt? }
//   shifts/{id}         présence : un document par scan du QR code { uid, firstName, lastName, day, createdAt }
//   products/{id}       { name, price (centimes), stock, threshold, order, active, image, lastSaleId }
//   sales/{id}          { productId, productName, unitPrice, qty, total, payment, createdAt, deviceId, volunteerName }
//   closures/{day}      clôture d'une journée (4h -> 4h), calculée par l'interface admin
//   invites/{token}     lien d'invitation gestionnaire { role, createdBy, createdAt, expiresAt, usedBy?, usedAt? }
//   managers/{uid}      gestionnaire invité { name, email, invite, createdAt } : produits et vente uniquement

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function accessKey() {
      return get(/databases/$(database)/documents/private/access).data.key;
    }

    function isName(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    // Bénévole = téléphone enregistré avec la clé du QR code actuel, pour la journée en cours (expire à 4h)
    function isVolunteer() {
      let path = /databases/$(database)/documents/devices/$(request.auth.uid);
      return signedIn()
        && exists(path)
        && get(path).data.key == accessKey()
        && request.time < get(path).data.expiresAt;
    }

    // Gestionnaire = compte créé via un lien d'invitation : produits et vente uniquement
    function isManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/managers/$(request.auth.uid));
    }

    function isStaff() {
      return isAdmin() || isManager();
    }

    function isSeller() {
      return isStaff() || isVolunteer();
    }

    // Une vente doit être accompagnée de la baisse de stock correspondante (même batch)
    function isValidSale(saleId) {
      let sale = request.resource.data;
      let productPath = /databases/$(database)/documents/products/$(sale.productId);
      let before = get(productPath).data;
      let after = getAfter(productPath).data;
      return sale.keys().hasOnly(['productId', 'productName', 'unitPrice', 'qty', 'total', 'payment', 'createdAt', 'deviceId', 'volunteerName'])
        && sale.keys().hasAll(['productId', 'productName', 'unitPrice', 'qty', 'total', 'payment', 'createdAt', 'deviceId', 'volunteerName'])
        && sale.productName is string
        && sale.qty is int && sale.qty >= 1 && sale.qty <= 99
        && sale.unitPrice == before.price
        && sale.total == sale.qty * sale.unitPrice
        && sale.payment in ['card', 'cash']
        && sale.createdAt == request.time
        && sale.deviceId == request.auth.uid
        && sale.volunteerName is string && sale.volunteerName.size() <= 90
        && after.lastSaleId == saleId
        && after.stock == before.stock - sale.qty;
    }

    // Un bénévole ne peut modifier un produit que pour décrémenter le stock d'une nouvelle vente
    function isSaleStockUpdate(productId) {
      let saleId = request.resource.data.lastSaleId;
      let sale = getAfter(/databases/$(database)/documents/sales/$(saleId)).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastSaleId'])
        && saleId is string
        && !exists(/databases/$(database)/documents/sales/$(saleId))
        && sale.productId == productId
        && request.resource.data.stock == resource.data.stock - sale.qty;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /private/{docId} {
      allow read, write: if isAdmin();
    }

    match /devices/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key', 'firstName', 'lastName', 'day', 'createdAt', 'expiresAt'])
        && request.resource.data.key == accessKey()
        && isName(request.resource.data.firstName)
        && isName(request.resource.data.lastName)
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      // « Quitter » : le bénévole note son départ, ce qui coupe son accès ; le téléphone reste visible côté admin
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leftAt', 'expiresAt'])
        && request.resource.data.leftAt == request.time
        && request.resource.data.expiresAt == request.time;
      allow delete: if isAdmin();
    }

    match /shifts/{shiftId} {
      allow read, delete: if isAdmin();
      // Créé dans le même batch que l'enregistrement du téléphone (qui vérifie la clé du QR code)
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'firstName', 'lastName', 'day', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/devices/$(request.auth.uid)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/devices/$(request.auth.uid)).data.firstName == request.resource.data.firstName
        && getAfter(/databases/$(database)/documents/devices/$(request.auth.uid)).data.lastName == request.resource.data.lastName
        && getAfter(/databases/$(database)/documents/devices/$(request.auth.uid)).data.day == request.resource.data.day;
    }

    match /products/{productId} {
      allow read: if isSeller();
      allow create: if isStaff();
      allow delete: if isAdmin();
      allow update: if isStaff() || (isVolunteer() && isSaleStockUpdate(productId));
    }

    match /sales/{saleId} {
      allow read, delete: if isAdmin();
      allow create: if isSeller() && isValidSale(saleId);
      allow update: if false;
    }

    match /invites/{token} {
      // Le jeton secret est l'identifiant : on lit une invitation dont on a le lien, sans pouvoir les lister
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.role == 'manager'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(72, 'h');
      // Usage unique, avant expiration, dans le même batch que la création du gestionnaire
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && existsAfter(/databases/$(database)/documents/managers/$(request.auth.uid));
    }

    match /managers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'invite', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.invite is string
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.usedBy == uid
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.usedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /closures/{day} {
      allow read, write: if isAdmin();
    }
  }
}
