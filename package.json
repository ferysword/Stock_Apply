{
  "name": "buvette-stock",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "npx -y firebase-tools@13 emulators:start --project demo-buvette",
    "seed": "node scripts/seed-emulator.mjs",
    "test:rules": "npx -y firebase-tools@13 emulators:exec --only firestore --project demo-buvette \"node --test tests/rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
